<?xml version="1.0" encoding="utf-8"?>
<!-- Changes ported from Gearslip 0.3.32-0.3.40 -->
<resources>
    <!-- In the car, a button of AntennaPod in the full-screen player (media/CarMedia.kt,
         withNextChapter): goes to the podcast episode's next chapter. Short: it is also
         the button's description, and its text when AntennaPod's icon can't be shown -->
    <string name="car_player_next_chapter">Próximo capítulo</string>
    <!-- Phone, Settings > Connection (ui/PhoneAddressRow.kt): the phone's own Bluetooth address,
         written by hand (Android hides it from apps), sent to a car already paired with the phone.
         The row's title, the line under it when none is written, the line under the field in its
         dialog (where Android shows it: use the names Android gives these pages in your language),
         and the error when what's written isn't an address -->
    <string name="settings_phone_bt_address">Endereço Bluetooth do telefone</string>
    <string name="settings_phone_bt_address_off">Não definido. Só para um carro que desliga o Bluetooth do telefone, ou se desconecta, quando o myCar se conecta.</string>
    <string name="settings_phone_bt_address_hint">Nas Configurações do Android &gt; Sobre o telefone (em alguns telefones, em Status): Endereço Bluetooth. O myCar o informa a um carro já pareado com o telefone, para que o carro saiba que é o mesmo telefone.</string>
    <string name="settings_phone_bt_address_invalid">Isso não é um endereço Bluetooth. Ele tem esta forma: 12:34:56:78:9A:BC.</string>
</resources>
