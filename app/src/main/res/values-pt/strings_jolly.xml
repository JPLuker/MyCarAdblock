<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jolly key (car/Jolly.kt, car/JollyScreen.kt, ui/JollySettings.kt): a key in the car's dock, above
  the microphone, that does one thing the driver picked with a single tap - a call, an assistant on the
  phone, something in Home Assistant, a place, a command for myCar's assistant, an app. Held, it opens
  its chooser on the car; on the phone it's in Settings > Car screen.
-->
<resources>
    <!-- The key's name, in the dock's description, the car's settings and the phone's: the wildcard card that
         can be anything. The same word in every language (in pirate speak "Jolly Roger"); the other texts take
         it as a placeholder, so a new name is one line per language. -->
    <string name="jolly_name">Jolly</string>
    <!-- What the key does: its description in the dock, and the car's word after a choice. %1$s: jolly_name,
         %2$s: what it does (one of the jolly_title_* below) -->
    <string name="jolly_does">%1$s: %2$s</string>

    <!-- Car, the chooser (the key held, or tapped with nothing chosen): under the tiles of the kinds. %1$s: jolly_name -->
    <string name="jolly_choose_intro">Um toque no botão faz o que você escolher aqui; mantenha-o pressionado para voltar. Também no telefone: Configurações > Tela do carro > %1$s.</string>
    <!-- Car, the chooser and the car's Settings: what the key does now. %1$s: one of the jolly_title_* below -->
    <string name="jolly_now">Agora: %1$s</string>

    <!-- The kinds of command: tiles in the car (about 150 dp wide: keep them short) and choices on the phone. -->
    <string name="jolly_kind_call">Ligar para alguém</string>
    <string name="jolly_kind_ai">Falar com uma IA</string>
    <string name="jolly_kind_home">Home Assistant</string>
    <string name="jolly_kind_navigate">Ir a um lugar</string>
    <!-- A phrase myCar's assistant understands, run as if it had been said -->
    <string name="jolly_kind_say">Comando ao myCar</string>
    <string name="jolly_kind_app">Abrir um app</string>

    <!-- What the key does, in the chooser, the settings and the toasts. %1$s: the contact's name -->
    <string name="jolly_title_call">Ligar para %1$s</string>
    <!-- %1$s: an assistant app's name (Gemini, Claude…) -->
    <string name="jolly_title_ai">Falar com %1$s</string>
    <!-- The phone's own assistant, whichever it is -->
    <string name="jolly_title_ai_phone">Falar com o assistente do telefone</string>
    <!-- Home Assistant: %1$s is the thing's name there. A script or a scene -->
    <string name="jolly_title_run">Iniciar %1$s</string>
    <!-- A button -->
    <string name="jolly_title_press">Pressionar %1$s</string>
    <!-- A switch, a light -->
    <string name="jolly_title_toggle">Ligar ou desligar %1$s</string>
    <!-- A gate, a garage door, a blind -->
    <string name="jolly_title_open_close">Abrir ou fechar %1$s</string>
    <string name="jolly_title_lock">Trancar %1$s</string>
    <string name="jolly_title_unlock">Destrancar %1$s</string>
    <!-- %1$s: the place's name ("Home"), or the place as written -->
    <string name="jolly_title_navigate">Ir para %1$s</string>
    <!-- A command for myCar's assistant, in the language's quotes. %1$s: the command as written -->
    <string name="jolly_title_say">“%1$s”</string>
    <!-- %1$s: the app's name -->
    <string name="jolly_title_app">Abrir %1$s</string>

    <!-- Car, the key's assistant with the phone locked, when Android doesn't let myCar light the phone
         (myCar off under Accessibility): as the microphone's "Unlock the phone, then touch the microphone
         again". %1$s: jolly_name -->
    <string name="jolly_unlock_then_touch">Desbloqueie o telefone e toque no botão %1$s de novo</string>
    <!-- Car and phone, a contact with several numbers, under the name. %1$d: how many -->
    <plurals name="jolly_numbers">
        <item quantity="one">%1$d número</item>
        <item quantity="other">%1$d números</item>
    </plurals>
    <!-- Car and phone, under the list of assistants -->
    <string name="jolly_ai_note">Ele ouve e responde no telefone, e a voz dele chega ao carro só por Bluetooth. Com o telefone bloqueado, ele começa quando você desbloqueia, ou, com o Home Assistant configurado no myCar, o myCar ouve e o Home Assistant responde.</string>
    <!-- Car (also as a toast when the key is tapped) and phone: Home Assistant isn't set up in myCar -->
    <string name="jolly_home_not_set">Primeiro configure o Plancia no telefone: Configurações > Plancia.</string>
    <!-- Car: Home Assistant can't be reached now (also as a toast when the key is tapped) -->
    <string name="jolly_home_offline">O Home Assistant não está conectado agora.</string>
    <!-- Car and phone, while the list comes -->
    <string name="jolly_home_loading">Perguntando ao Home Assistant…</string>
    <string name="jolly_home_none">O Home Assistant não tem nada que o botão possa executar: nenhum script, cena, botão, interruptor, luz, portão ou fechadura.</string>
    <!-- Car and phone, under a list with locks in it -->
    <string name="jolly_home_unlock_note">Para destrancar, o botão espera um segundo toque em até 3 segundos.</string>
    <!-- Car, the chooser: a place is written on the phone. %1$s: jolly_name -->
    <string name="jolly_navigate_on_phone">Os lugares são escritos no telefone: Configurações > Tela do carro > %1$s.</string>
    <!-- Car, the chooser, under the ready-made commands. %1$s: jolly_name -->
    <string name="jolly_say_on_phone">Qualquer outro comando: escreva no telefone, em Configurações > Tela do carro > %1$s.</string>

    <!-- Ready-made commands, offered in the car and on the phone. Each is said to myCar's assistant as it's
         written here, so in every language it must be a phrase the assistant understands (see the help of
         car/AssistantXxx.kt; JollyActionTest checks them). No pirate versions: the assistant wouldn't follow. -->
    <string name="jolly_say_messages">Leia as mensagens</string>
    <string name="jolly_say_arrival">Quando eu chego?</string>
    <string name="jolly_say_call_back">Ligue de volta</string>
    <string name="jolly_say_weather">Como está o tempo?</string>

    <!-- Car, toasts when the key is tapped. %1$s: the thing's name in Home Assistant -->
    <string name="jolly_home_done">%1$s: feito</string>
    <!-- %1$s: the thing's name in Home Assistant, %2$s: why, in Home Assistant's own words -->
    <string name="jolly_home_failed">%1$s não funcionou: %2$s</string>
    <!-- Home Assistant doesn't have the thing (any more): nothing was sent. %1$s: its name there -->
    <string name="jolly_home_missing">%1$s não está no Home Assistant. Mantenha o botão pressionado para escolher outra coisa.</string>
    <!-- Home Assistant can't reach the thing now (its state is "unavailable"): nothing was sent -->
    <string name="jolly_home_unavailable">%1$s não está disponível no Home Assistant agora.</string>
    <!-- A lock, after the key's command: it says it's stuck -->
    <string name="jolly_lock_jammed">%1$s: a fechadura está emperrada.</string>
    <!-- A lock still as it was 10 seconds after being told to open, or to close -->
    <string name="jolly_lock_still_locked">%1$s: a fechadura continua trancada.</string>
    <string name="jolly_lock_still_unlocked">%1$s: a fechadura continua destrancada.</string>
    <!-- A lock still on its way, or silent, 10 seconds after the command -->
    <string name="jolly_lock_no_news">%1$s ainda não disse se funcionou.</string>
    <!-- A lock, at the first tap. %1$s: its name in Home Assistant -->
    <string name="jolly_confirm_unlock">Destrancar %1$s? Toque no botão de novo em até 3 segundos.</string>
    <!-- %1$s: the place's name or the place, %2$s: the map app -->
    <string name="jolly_navigating">A caminho de %1$s com %2$s</string>
    <string name="jolly_no_map">Não há nenhum app de mapas no telefone.</string>
    <!-- %1$s: the app's name -->
    <string name="jolly_app_gone">%1$s não está mais no telefone. Mantenha o botão pressionado para escolher outra coisa.</string>
    <!-- The contact's number chosen for the key isn't theirs in the contacts any more: the chooser opens.
         %1$s: the contact's name -->
    <string name="jolly_call_gone">%1$s não tem mais esse número nos contatos: escolha de novo.</string>
    <!-- A call, an assistant or a command while on a call -->
    <string name="jolly_after_call">Isso precisa esperar o fim da chamada.</string>

    <!-- The car's Settings and the phone's (Settings > Car screen): the On/Off choice, a switch on the phone. %1$s: jolly_name -->
    <string name="car_settings_jolly_key">Botão %1$s</string>
    <!-- Car's Settings: the button that opens the chooser -->
    <string name="car_settings_jolly_choose">Escolher o que ele faz</string>
    <string name="car_settings_jolly_none">Nada escolhido ainda: um toque no botão pergunta.</string>

    <!-- Phone, Settings > Car screen, the key's section: under the switch -->
    <string name="settings_jolly_key_detail">No dock, acima do microfone: um toque faz o que você escolher aqui</string>
    <!-- The row that opens the kinds; under it, what the key does -->
    <string name="settings_jolly_action">O que ele faz</string>
    <string name="settings_jolly_none">Nada ainda: no carro, um toque no botão pergunta</string>
    <!-- Title of the list of kinds -->
    <string name="settings_jolly_kind">O que o botão deve fazer?</string>
    <string name="settings_jolly_footer">Uma chamada, um assistente, algo no Home Assistant, um lugar, um comando ou um app, a um toque. No carro, mantenha o botão pressionado para mudar por lá também.</string>
    <!-- In the list of contacts, without the permission, over an Allow button -->
    <string name="settings_jolly_contacts_permission">O myCar precisa ler seus contatos para listá-los.</string>
    <!-- A place: the field for it, the field for the name the car shows, and a note under them -->
    <string name="settings_jolly_place">Endereço ou lugar</string>
    <string name="settings_jolly_place_name">Nome no carro (opcional)</string>
    <string name="settings_jolly_place_note">Vai para o app de mapas do carro do jeito que você escrever, como quando você diz ao assistente do myCar aonde ir.</string>
    <!-- A command: the field, and a note under the ready-made ones -->
    <string name="settings_jolly_phrase">Comando</string>
    <string name="settings_jolly_phrase_note">Escreva como você diria ao assistente do myCar, no idioma do myCar: “toca Radio Deejay no Spotify”, “abra o portão”. No carro, o botão mostra o comando e o assistente responde.</string>
    <!-- Home Assistant didn't give its list. %1$s: why, in its own words -->
    <string name="settings_jolly_home_failed">O Home Assistant não respondeu: %1$s</string>
</resources>
