<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jolly key (car/Jolly.kt, car/JollyScreen.kt, ui/JollySettings.kt): a key in the car's dock, above
  the microphone, that does one thing the driver picked with a single tap - a call, an assistant on the
  phone, something in Home Assistant, a place, a command for myCar's assistant, an app. Held, it opens
  its chooser on the car; on the phone it's in Settings > Car screen.
-->
<resources>
    <!-- The key's name, in the dock's description, the car's settings and the phone's: the wildcard card that
         can be anything. The same word in every language (in pirate speak "Jolly Roger"); the other texts take
         it as a placeholder, so a new name is one line per language. -->
    <string name="jolly_name">Jolly</string>
    <!-- What the key does: its description in the dock, and the car's word after a choice. %1$s: jolly_name,
         %2$s: what it does (one of the jolly_title_* below) -->
    <string name="jolly_does">%1$s: %2$s</string>

    <!-- Car, the chooser (the key held, or tapped with nothing chosen): under the tiles of the kinds. %1$s: jolly_name -->
    <string name="jolly_choose_intro">Ein Tippen auf die Taste macht, was du hier wählst; halte sie gedrückt, um hierher zurückzukommen. Auch auf dem Telefon: Einstellungen > Bildschirm des Autos > %1$s.</string>
    <!-- Car, the chooser and the car's Settings: what the key does now. %1$s: one of the jolly_title_* below -->
    <string name="jolly_now">Jetzt: %1$s</string>

    <!-- The kinds of command: tiles in the car (about 150 dp wide: keep them short) and choices on the phone. -->
    <string name="jolly_kind_call">Kontakt anrufen</string>
    <string name="jolly_kind_ai">Mit KI sprechen</string>
    <string name="jolly_kind_home">Home Assistant</string>
    <string name="jolly_kind_navigate">Ort ansteuern</string>
    <!-- A phrase myCar's assistant understands, run as if it had been said -->
    <string name="jolly_kind_say">Assistent-Befehl</string>
    <string name="jolly_kind_app">App öffnen</string>

    <!-- What the key does, in the chooser, the settings and the toasts. %1$s: the contact's name -->
    <string name="jolly_title_call">%1$s anrufen</string>
    <!-- %1$s: an assistant app's name (Gemini, Claude…) -->
    <string name="jolly_title_ai">Mit %1$s sprechen</string>
    <!-- The phone's own assistant, whichever it is -->
    <string name="jolly_title_ai_phone">Mit dem Assistenten des Telefons sprechen</string>
    <!-- Home Assistant: %1$s is the thing's name there. A script or a scene -->
    <string name="jolly_title_run">%1$s starten</string>
    <!-- A button -->
    <string name="jolly_title_press">%1$s drücken</string>
    <!-- A switch, a light -->
    <string name="jolly_title_toggle">%1$s ein- oder ausschalten</string>
    <!-- A gate, a garage door, a blind -->
    <string name="jolly_title_open_close">%1$s öffnen oder schließen</string>
    <string name="jolly_title_lock">%1$s verriegeln</string>
    <string name="jolly_title_unlock">%1$s entriegeln</string>
    <!-- %1$s: the place's name ("Home"), or the place as written -->
    <string name="jolly_title_navigate">Ziel: %1$s</string>
    <!-- A command for myCar's assistant, in the language's quotes. %1$s: the command as written -->
    <string name="jolly_title_say">„%1$s“</string>
    <!-- %1$s: the app's name -->
    <string name="jolly_title_app">%1$s öffnen</string>

    <!-- Car and phone, a contact with several numbers, under the name. %1$d: how many -->
    <plurals name="jolly_numbers">
        <item quantity="one">%1$d Nummer</item>
        <item quantity="other">%1$d Nummern</item>
    </plurals>
    <!-- Car and phone, under the list of assistants -->
    <string name="jolly_ai_note">Er hört zu und antwortet auf dem Telefon, und seine Stimme kommt nur über Bluetooth ins Auto. Bei gesperrtem Telefon startet er, sobald du es entsperrst, oder, ist Home Assistant in myCar eingerichtet, hört myCar zu und Home Assistant antwortet.</string>
    <!-- Car (also as a toast when the key is tapped) and phone: Home Assistant isn't set up in myCar -->
    <string name="jolly_home_not_set">Richte zuerst Plancia auf dem Telefon ein: Einstellungen > Plancia.</string>
    <!-- Car: Home Assistant can't be reached now (also as a toast when the key is tapped) -->
    <string name="jolly_home_offline">Home Assistant ist gerade nicht verbunden.</string>
    <!-- Car and phone, while the list comes -->
    <string name="jolly_home_loading">Frage Home Assistant…</string>
    <string name="jolly_home_none">Home Assistant hat nichts, was die Taste ausführen kann: keine Skripte, Szenen, Tasten, Schalter, Lichter, Tore oder Schlösser.</string>
    <!-- Car and phone, under a list with locks in it -->
    <string name="jolly_home_unlock_note">Zum Entriegeln wartet die Taste auf ein zweites Tippen innerhalb von 3 Sekunden.</string>
    <!-- Car, the chooser: a place is written on the phone. %1$s: jolly_name -->
    <string name="jolly_navigate_on_phone">Orte schreibst du auf dem Telefon: Einstellungen > Bildschirm des Autos > %1$s.</string>
    <!-- Car, the chooser, under the ready-made commands. %1$s: jolly_name -->
    <string name="jolly_say_on_phone">Jeder andere Befehl: Schreib ihn auf dem Telefon, unter Einstellungen > Bildschirm des Autos > %1$s.</string>

    <!-- Ready-made commands, offered in the car and on the phone. Each is said to myCar's assistant as it's
         written here, so in every language it must be a phrase the assistant understands (see the help of
         car/AssistantXxx.kt; JollyActionTest checks them). No pirate versions: the assistant wouldn't follow. -->
    <string name="jolly_say_messages">Lies meine Nachrichten</string>
    <string name="jolly_say_arrival">Wann komme ich an?</string>
    <string name="jolly_say_call_back">Ruf zurück</string>
    <string name="jolly_say_weather">Wie ist das Wetter?</string>

    <!-- Car, toasts when the key is tapped. %1$s: the thing's name in Home Assistant -->
    <string name="jolly_home_done">%1$s: erledigt</string>
    <!-- %1$s: the thing's name in Home Assistant, %2$s: why, in Home Assistant's own words -->
    <string name="jolly_home_failed">%1$s hat nicht geklappt: %2$s</string>
    <!-- Home Assistant doesn't have the thing (any more): nothing was sent. %1$s: its name there -->
    <string name="jolly_home_missing">%1$s gibt es in Home Assistant nicht. Halte die Taste gedrückt, um etwas anderes zu wählen.</string>
    <!-- Home Assistant can't reach the thing now (its state is "unavailable"): nothing was sent -->
    <string name="jolly_home_unavailable">%1$s ist in Home Assistant gerade nicht verfügbar.</string>
    <!-- A lock, after the key's command: it says it's stuck -->
    <string name="jolly_lock_jammed">%1$s: Das Schloss klemmt.</string>
    <!-- A lock still as it was 10 seconds after being told to open, or to close -->
    <string name="jolly_lock_still_locked">%1$s: Das Schloss ist noch verriegelt.</string>
    <string name="jolly_lock_still_unlocked">%1$s: Das Schloss ist noch entriegelt.</string>
    <!-- A lock still on its way, or silent, 10 seconds after the command -->
    <string name="jolly_lock_no_news">%1$s hat noch nicht gemeldet, ob es geklappt hat.</string>
    <!-- A lock, at the first tap. %1$s: its name in Home Assistant -->
    <string name="jolly_confirm_unlock">%1$s entriegeln? Tippe innerhalb von 3 Sekunden noch einmal auf die Taste.</string>
    <!-- %1$s: the place's name or the place, %2$s: the map app -->
    <string name="jolly_navigating">Unterwegs nach %1$s mit %2$s</string>
    <string name="jolly_no_map">Auf dem Telefon ist keine Karten-App.</string>
    <!-- %1$s: the app's name -->
    <string name="jolly_app_gone">%1$s ist nicht mehr auf dem Telefon. Halte die Taste gedrückt, um etwas anderes zu wählen.</string>
    <!-- The contact's number chosen for the key isn't theirs in the contacts any more: the chooser opens.
         %1$s: the contact's name -->
    <string name="jolly_call_gone">%1$s hat diese Nummer nicht mehr in den Kontakten: wähle neu.</string>
    <!-- A call, an assistant or a command while on a call -->
    <string name="jolly_after_call">Das muss warten, bis der Anruf vorbei ist.</string>

    <!-- The car's Settings and the phone's (Settings > Car screen): the On/Off choice, a switch on the phone. %1$s: jolly_name -->
    <string name="car_settings_jolly_key">%1$s-Taste</string>
    <!-- Car's Settings: the button that opens the chooser -->
    <string name="car_settings_jolly_choose">Wählen, was sie macht</string>
    <string name="car_settings_jolly_none">Noch nichts gewählt: Ein Tippen auf die Taste fragt nach.</string>

    <!-- Phone, Settings > Car screen, the key's section: under the switch -->
    <string name="settings_jolly_key_detail">Im Dock über dem Mikrofon: Ein Tippen macht, was du hier wählst</string>
    <!-- The row that opens the kinds; under it, what the key does -->
    <string name="settings_jolly_action">Was sie macht</string>
    <string name="settings_jolly_none">Noch nichts: Im Auto fragt ein Tippen auf die Taste nach</string>
    <!-- Title of the list of kinds -->
    <string name="settings_jolly_kind">Was soll die Taste machen?</string>
    <string name="settings_jolly_footer">Ein Anruf, ein Assistent, etwas in Home Assistant, ein Ort, ein Befehl oder eine App, nur ein Tippen entfernt. Halte die Taste im Auto gedrückt, um sie auch dort zu ändern.</string>
    <!-- In the list of contacts, without the permission, over an Allow button -->
    <string name="settings_jolly_contacts_permission">myCar muss deine Kontakte lesen dürfen, um sie aufzulisten.</string>
    <!-- A place: the field for it, the field for the name the car shows, and a note under them -->
    <string name="settings_jolly_place">Adresse oder Ort</string>
    <string name="settings_jolly_place_name">Name im Auto (optional)</string>
    <string name="settings_jolly_place_note">Er geht so an die Karten-App des Autos, wie du ihn schreibst, wie wenn du dem Assistenten von myCar sagst, wohin es geht.</string>
    <!-- A command: the field, and a note under the ready-made ones -->
    <string name="settings_jolly_phrase">Befehl</string>
    <string name="settings_jolly_phrase_note">Schreib ihn so, wie du ihn dem Assistenten von myCar sagen würdest, in der Sprache von myCar: „spiel Radio Deejay auf Spotify“, „öffne das Tor“. Im Auto zeigt die Taste ihn an, und der Assistent antwortet.</string>
    <!-- Home Assistant didn't give its list. %1$s: why, in its own words -->
    <string name="settings_jolly_home_failed">Home Assistant hat nicht geantwortet: %1$s</string>
</resources>
