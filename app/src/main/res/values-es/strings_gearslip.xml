<?xml version="1.0" encoding="utf-8"?>
<!-- Changes ported from Gearslip 0.3.32-0.3.40 -->
<resources>
    <!-- In the car, a button of AntennaPod in the full-screen player (media/CarMedia.kt,
         withNextChapter): goes to the podcast episode's next chapter. Short: it is also
         the button's description, and its text when AntennaPod's icon can't be shown -->
    <string name="car_player_next_chapter">Siguiente capítulo</string>
    <!-- Phone, Settings > Connection (ui/PhoneAddressRow.kt): the phone's own Bluetooth address,
         written by hand (Android hides it from apps), sent to a car already paired with the phone.
         The row's title, the line under it when none is written, the line under the field in its
         dialog (where Android shows it: use the names Android gives these pages in your language),
         and the error when what's written isn't an address -->
    <string name="settings_phone_bt_address">Dirección Bluetooth del teléfono</string>
    <string name="settings_phone_bt_address_off">Sin configurar. Solo para un coche que le quita el Bluetooth al teléfono, o se desconecta, cuando myCar se conecta.</string>
    <string name="settings_phone_bt_address_hint">En los Ajustes de Android &gt; Información del teléfono (en algunos teléfonos, dentro de Estado): Dirección de Bluetooth. myCar se la dice a un coche ya vinculado con el teléfono, para que el coche sepa que es el mismo teléfono.</string>
    <string name="settings_phone_bt_address_invalid">No es una dirección Bluetooth. Tiene esta forma: 12:34:56:78:9A:BC.</string>
</resources>
