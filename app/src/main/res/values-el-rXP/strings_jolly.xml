<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jolly key in pirate speak (see values/strings_jolly.xml): its name is the Jolly Roger, the key a flag
  on the mast. Safety, errors and the ready-made commands (which the assistant reads) stay as in the language.
-->
<resources>
    <!-- The key's name, in the dock's description, the car's settings and the phone's: the wildcard card that
         can be anything. The same word in every language (in pirate speak "Jolly Roger"); the other texts take
         it as a placeholder, so a new name is one line per language. -->
    <string name="jolly_name">Jolly Roger</string>
    <!-- Car, the chooser (the key held, or tapped with nothing chosen): under the tiles of the kinds. %1$s: jolly_name -->
    <string name="jolly_choose_intro">Ένα πάτημα στη σημαία κάνει ό,τι επιλέξετε εδώ· κρατήστε την πατημένη για να επιστρέψετε. Και στο τηλέφωνο: Ξάρτια > Οθόνη καραβιού > %1$s.</string>
    <!-- Car, the chooser and the car's Settings: what the key does now. %1$s: one of the jolly_title_* below -->
    <string name="jolly_now">Κυματίζει τώρα: %1$s</string>
    <!-- The kinds of command: tiles in the car (about 150 dp wide: keep them short) and choices on the phone. -->
    <string name="jolly_kind_call">Κάλεσμα συντρόφου</string>
    <string name="jolly_kind_ai">Κουβέντα με AI</string>
    <string name="jolly_kind_navigate">Χάραξη πορείας</string>
    <!-- A phrase myCar's assistant understands, run as if it had been said -->
    <string name="jolly_kind_say">Διαταγή στον παπαγάλο</string>
    <string name="jolly_kind_app">Ρεσάλτο σε εφαρμογή</string>
    <!-- What the key does, in the chooser, the settings and the toasts. %1$s: the contact's name -->
    <string name="jolly_title_call">Κάλεσμα: %1$s</string>
    <!-- %1$s: an assistant app's name (Gemini, Claude…) -->
    <string name="jolly_title_ai">Κουβέντα με %1$s</string>
    <!-- The phone's own assistant, whichever it is -->
    <string name="jolly_title_ai_phone">Κουβέντα με τον παπαγάλο του τηλεφώνου</string>
    <!-- %1$s: the place's name ("Home"), or the place as written -->
    <string name="jolly_title_navigate">Πορεία: %1$s</string>
    <!-- %1$s: the app's name -->
    <string name="jolly_title_app">Ρεσάλτο: %1$s</string>
    <!-- Car and phone, under the list of assistants -->
    <string name="jolly_ai_note">Ακούει και απαντά στο τηλέφωνο, και η φωνή του ανεβαίνει στο καράβι μόνο μέσω Bluetooth. Με κλειδωμένο τηλέφωνο ξεκινά μόλις το ξεκλειδώσετε, ή, με το Home Assistant ρυθμισμένο στο myCar, ακούει το myCar και απαντά το Home Assistant.</string>
    <!-- Car, the chooser: a place is written on the phone. %1$s: jolly_name -->
    <string name="jolly_navigate_on_phone">Τα λιμάνια γράφονται στο τηλέφωνο: Ξάρτια > Οθόνη καραβιού > %1$s.</string>
    <!-- Car, the chooser, under the ready-made commands. %1$s: jolly_name -->
    <string name="jolly_say_on_phone">Οποιαδήποτε άλλη διαταγή: γράψτε την στο τηλέφωνο, στα Ξάρτια > Οθόνη καραβιού > %1$s.</string>
    <!-- %1$s: the place's name or the place, %2$s: the map app -->
    <string name="jolly_navigating">Πλώρη για %1$s με %2$s</string>
    <!-- The car's Settings and the phone's (Settings > Car screen): the On/Off choice, a switch on the phone. %1$s: jolly_name -->
    <string name="car_settings_jolly_key">%1$s στον μόλο</string>
    <!-- Car's Settings: the button that opens the chooser -->
    <string name="car_settings_jolly_choose">Δώστε της διαταγές</string>
    <string name="car_settings_jolly_none">Καμία διαταγή ακόμη: ένα πάτημα στη σημαία ρωτάει.</string>
    <!-- Phone, Settings > Car screen, the key's section: under the switch -->
    <string name="settings_jolly_key_detail">Στον μόλο, πάνω από τον παπαγάλο του καραβιού: ένα πάτημα κάνει ό,τι επιλέξετε εδώ</string>
    <!-- The row that opens the kinds; under it, what the key does -->
    <string name="settings_jolly_action">Οι διαταγές της</string>
    <string name="settings_jolly_none">Καμία διαταγή ακόμη: στο καράβι, ένα πάτημα στη σημαία ρωτάει</string>
    <!-- Title of the list of kinds -->
    <string name="settings_jolly_kind">Τι διαταγές για τη σημαία;</string>
    <string name="settings_jolly_footer">Μια κλήση, ένας παπαγάλος, κάτι στο Home Assistant, ένα λιμάνι, μια διαταγή ή μια εφαρμογή, με ένα πάτημα. Στο καράβι, κρατήστε πατημένη τη σημαία για να την αλλάξετε κι εκεί.</string>
    <!-- A place: the field for it, the field for the name the car shows, and a note under them -->
    <string name="settings_jolly_place">Διεύθυνση ή λιμάνι</string>
    <string name="settings_jolly_place_name">Όνομα στο καράβι (προαιρετικό)</string>
    <string name="settings_jolly_place_note">Πηγαίνει στην εφαρμογή χαρτών του καραβιού όπως το γράφετε, όπως όταν λέτε στον παπαγάλο του myCar πού να βάλει πλώρη.</string>
    <!-- A command: the field, and a note under the ready-made ones -->
    <string name="settings_jolly_phrase">Διαταγή</string>
    <string name="settings_jolly_phrase_note">Γράψτε την όπως θα τη λέγατε στον παπαγάλο του myCar, στη γλώσσα του myCar: «βάλε Radio Deejay στο Spotify», «άνοιξε την καγκελόπορτα». Στο καράβι η σημαία τη δείχνει και ο παπαγάλος απαντά.</string>
</resources>
