<?xml version="1.0" encoding="utf-8"?>
<!--
  The Jolly key in pirate speak (see values/strings_jolly.xml): its name is the Jolly Roger, the key a flag
  on the mast. Safety, errors and the ready-made commands (which the assistant reads) stay as in the language.
-->
<resources>
    <!-- The key's name, in the dock's description, the car's settings and the phone's: the wildcard card that
         can be anything. The same word in every language (in pirate speak "Jolly Roger"); the other texts take
         it as a placeholder, so a new name is one line per language. -->
    <string name="jolly_name">Jolly Roger</string>
    <!-- Car, the chooser (the key held, or tapped with nothing chosen): under the tiles of the kinds. %1$s: jolly_name -->
    <string name="jolly_choose_intro">Нажатие на флаг делает то, что вы выберете здесь; удерживайте его, чтобы вернуться сюда. Также на телефоне: Такелаж > Бортовой экран > %1$s.</string>
    <!-- Car, the chooser and the car's Settings: what the key does now. %1$s: one of the jolly_title_* below -->
    <string name="jolly_now">Сейчас реет: %1$s</string>
    <!-- The kinds of command: tiles in the car (about 150 dp wide: keep them short) and choices on the phone. -->
    <string name="jolly_kind_call">Позвать матроса</string>
    <string name="jolly_kind_ai">Переговоры с ИИ</string>
    <string name="jolly_kind_navigate">Проложить курс</string>
    <!-- A phrase myCar's assistant understands, run as if it had been said -->
    <string name="jolly_kind_say">Приказ попугаю</string>
    <string name="jolly_kind_app">На абордаж!</string>
    <!-- What the key does, in the chooser, the settings and the toasts. %1$s: the contact's name -->
    <string name="jolly_title_call">Окликнуть: %1$s</string>
    <!-- %1$s: an assistant app's name (Gemini, Claude…) -->
    <string name="jolly_title_ai">Переговоры: %1$s</string>
    <!-- The phone's own assistant, whichever it is -->
    <string name="jolly_title_ai_phone">Переговоры с попугаем телефона</string>
    <!-- %1$s: the place's name ("Home"), or the place as written -->
    <string name="jolly_title_navigate">Курс: %1$s</string>
    <!-- %1$s: the app's name -->
    <string name="jolly_title_app">Абордаж: %1$s</string>
    <!-- Car and phone, under the list of assistants -->
    <string name="jolly_ai_note">Он слушает и отвечает на телефоне, а его голос попадает на борт только по Bluetooth. Если телефон заблокирован, он запустится, как только вы его разблокируете, а если в myCar настроен Home Assistant, слушает myCar и отвечает Home Assistant.</string>
    <!-- Car, the chooser: a place is written on the phone. %1$s: jolly_name -->
    <string name="jolly_navigate_on_phone">Порты вводятся на телефоне: Такелаж > Бортовой экран > %1$s.</string>
    <!-- Car, the chooser, under the ready-made commands. %1$s: jolly_name -->
    <string name="jolly_say_on_phone">Любой другой приказ введите на телефоне: Такелаж > Бортовой экран > %1$s.</string>
    <!-- %1$s: the place's name or the place, %2$s: the map app -->
    <string name="jolly_navigating">Курс на %1$s, через %2$s</string>
    <!-- The car's Settings and the phone's (Settings > Car screen): the On/Off choice, a switch on the phone. %1$s: jolly_name -->
    <string name="car_settings_jolly_key">%1$s на мачте</string>
    <!-- Car's Settings: the button that opens the chooser -->
    <string name="car_settings_jolly_choose">Отдать приказы</string>
    <string name="car_settings_jolly_none">Приказов пока нет: нажатие на флаг спросит.</string>
    <!-- Phone, Settings > Car screen, the key's section: under the switch -->
    <string name="settings_jolly_key_detail">На мачте над корабельным попугаем: одно нажатие делает то, что вы выберете здесь</string>
    <!-- The row that opens the kinds; under it, what the key does -->
    <string name="settings_jolly_action">Приказы</string>
    <string name="settings_jolly_none">Приказов пока нет: на борту нажатие на флаг спросит</string>
    <!-- Title of the list of kinds -->
    <string name="settings_jolly_kind">Какие приказы для флага?</string>
    <string name="settings_jolly_footer">Звонок, попугай, что-то в Home Assistant, порт, приказ или приложение в одно нажатие. На борту удерживайте флаг, чтобы изменить это и там.</string>
    <!-- A place: the field for it, the field for the name the car shows, and a note under them -->
    <string name="settings_jolly_place">Адрес или порт</string>
    <string name="settings_jolly_place_name">Название на борту (необязательно)</string>
    <string name="settings_jolly_place_note">Оно уходит в приложение карт корабля так, как вы его напишете, как когда вы говорите попугаю myCar, куда держать курс.</string>
    <!-- A command: the field, and a note under the ready-made ones -->
    <string name="settings_jolly_phrase">Приказ</string>
    <string name="settings_jolly_phrase_note">Напишите его так, как сказали бы попугаю myCar, на языке myCar: «включить Radio Deejay в Spotify», «открыть ворота». На борту флаг покажет его, а попугай ответит.</string>
</resources>
